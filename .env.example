# igbot configuration. Copy to `.env` for local dev, or use as the basis for
# /etc/igbot/igbot.env on the server (systemd EnvironmentFile).

# --- required ---
TELEGRAM_BOT_TOKEN=123456:replace-with-your-botfather-token

# --- strongly recommended ---
# Comma-separated chat IDs the bot will act in. Empty = ANY chat (not advised).
# Tip: add the bot to your group, post a message, and read the chat id from logs.
ALLOWED_CHAT_IDS=

# --- paths / tools ---
TEMP_DIR=./tmp
YT_DLP_PATH=yt-dlp
GALLERY_DL_PATH=gallery-dl

# --- cookieless-first (leave unset by default) ---
# Path to a Netscape cookies.txt from a BURNER account. Setting this activates
# gallery-dl and adds --cookies to yt-dlp. Disposable account only (PLAN §4.5).
# IG_COOKIES_PATH=/etc/igbot/cookies.txt

# --- external fallback (off by default; PLAN §4.8) ---
# FALLBACK_PROVIDER=embedez      # or: jina
# JINA_API_KEY=                  # free key; required for Jina to work on IG

# --- tuning (sensible defaults shown) ---
# CACHE_TTL_SECS=1200            # dedup window
# QUEUE_CAPACITY=16              # bounded job queue; over this → "busy" reply
# JOB_TIMEOUT_SECS=90            # per-job wall-clock cap
# REQUEST_PACING_MS=1500         # pause between jobs
# MAX_UPLOAD_BYTES=52428800      # 50 MB Bot API upload cap
# USER_AGENT=                    # override the default desktop-Chrome UA (CDN downloads)
# EMBED_USER_AGENT=              # override the embed scraper's crawler UA. Current
#                                # Instagram serves browser UAs a JS-only shell with no
#                                # media; the crawler UA (facebookexternalhit) still gets
#                                # the post's media. Change here if IG breaks it (no recompile).

# --- threads.com / threads.net (on by default; cookieless) ---
# THREADS_ENABLED=true           # set 0/false/no/off to ignore Threads links entirely
# THREADS_USER_AGENT=            # override the Threads scraper UA. MUST be a real desktop
#                                # browser UA: Threads serves its server-rendered post JSON
#                                # only to a coherent browser header set; a crawler/naive UA
#                                # gets an empty shell. Defaults to the desktop-Chrome UA.
# THREADS_SEC_CH_UA=             # the matching `sec-ch-ua` client-hint; keep it coherent
#                                # with THREADS_USER_AGENT's Chrome major (no recompile).

# --- logging / observability ---
# RUST_LOG=igbot=info,warn       # log filter (use igbot=debug for HTTP/extraction detail)
# HEARTBEAT_SECS=3600            # periodic liveness+metrics log line; 0 disables
# LOG_DIR=                       # if set, ALSO write daily-rotating log files here.
#                                # journald already persists stdout on the VM, so this is
#                                # optional. On the systemd unit, point it inside the
#                                # service's ReadWritePaths (e.g. /opt/igbot/logs).
# LOG_MAX_FILES=7                # rotated log files to keep (bounds disk)
